# Postgres. On Neon, DATABASE_URL is the pooled string (host has -pooler in it) and
# DIRECT_URL is the direct one. Locally they can be the same.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lockin"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/lockin"

# Any long random string. Generate one with: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string"

# Public address, used for social preview images. Vercel sets its own, so this is optional there.
# APP_URL="https://lockin.example.com"

# Password reset emails, sent with Resend. Leave unset and the "Forgot your password?" link is hidden.
# In development, reset links are printed to the terminal instead.
# RESEND_API_KEY=""
# EMAIL_FROM="Lockin <hello@yourdomain.com>"

# Avatars and timelapses. Leave these unset to keep files on local disk (dev only).
# On Vercel the disk doesn't persist, so an S3-compatible bucket is required.
# UPLOAD_DIR=".uploads"
# S3_BUCKET="lockin-media"
# S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
# S3_REGION="auto"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_PUBLIC_URL="https://media.example.com"
