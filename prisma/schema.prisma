generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled connection, used by the app
  directUrl = env("DIRECT_URL") // direct connection, used by migrations
}

model User {
  id                String    @id @default(cuid())
  username          String    @unique
  name              String
  email             String    @unique
  /// Null for people who only sign in with Google or GitHub.
  passwordHash      String?
  bio               String?
  avatar            String?
  sceneId           String?
  clockStyle        String    @default("ring")
  passwordChangedAt DateTime?
  dailyGoalMin      Int       @default(60)
  /// IANA zone from the browser at signup. "Today", streaks and day totals use it.
  timeZone          String    @default("UTC")
  /// Set when the person clicks the link in their verification email, or resets their password by email.
  emailVerifiedAt   DateTime?
  /// True for accounts made before email verification existed. They get a grace period once it's enforced.
  legacyUnverified  Boolean   @default(false)
  /// When a legacy account's grace period ends. Starts the first time they're seen after enforcement is turned on.
  verifyGraceEndsAt DateTime?
  /// Set by an admin. A banned account can't sign in, and what it posted is hidden from everyone.
  bannedAt          DateTime?
  createdAt         DateTime  @default(now())

  dailyStats     DailyStat[]
  sessions       FocusSession[]
  posts          Post[]
  likes          Like[]
  comments       Comment[]
  following      Follow[]            @relation("follower")
  followers      Follow[]            @relation("following")
  notifications  Notification[]      @relation("recipient")
  actions        Notification[]      @relation("actor")
  buddyRequests  Buddy[]             @relation("requester")
  buddyInvites   Buddy[]             @relation("addressee")
  roomsOwned     Room[]
  roomMembers    RoomMember[]
  passwordResets PasswordReset[]
  verifications  EmailVerification[]
  oauthAccounts  OAuthAccount[]
  postViews      PostView[]
  quests         Quest[]
  questsJoined   QuestParticipant[]
  questionsMade  DailyQuestion[]
  questionVotes  QuestionVote[]
  takes          Take[]
  takeReactions  TakeReaction[]
  reports        Report[]
  blocking       Block[]             @relation("blocker")
  blockedBy      Block[]             @relation("blocked")
  muting         Mute[]              @relation("muter")
  mutedBy        Mute[]              @relation("muted")
  adminActions   AdminAction[]
}

/**
 * What an admin did and to what, newest first on the admin page.
 */
model AdminAction {
  id            String   @id @default(cuid())
  /// Null once the admin's account is deleted; adminUsername keeps who it was.
  adminId       String?
  adminUsername String
  /// "dismiss" | "hide" | "delete" | "restore" | "ban" | "unban" | "question"
  action        String
  /// "post" | "comment" | "quest" | "take" | "user" | "question"
  targetType    String
  targetId      String
  /// A short human summary, e.g. the start of a post or a username, since the target may be gone.
  detail        String?
  createdAt     DateTime @default(now())

  admin User? @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([createdAt])
}

/// Either side of a block hides the two people from each other and stops them interacting.
model Block {
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
}

/// Hides someone's posts from the muter's feed. The muted person isn't told and can still interact.
model Mute {
  muterId   String
  mutedId   String
  createdAt DateTime @default(now())

  muter User @relation("muter", fields: [muterId], references: [id], onDelete: Cascade)
  muted User @relation("muted", fields: [mutedId], references: [id], onDelete: Cascade)

  @@id([muterId, mutedId])
}

/// One timer run. status: ACTIVE | DONE | ABANDONED
model FocusSession {
  id          String    @id @default(cuid())
  userId      String
  label       String?
  goalMin     Int
  startedAt   DateTime  @default(now())
  endedAt     DateTime?
  lastBeatAt  DateTime  @default(now())
  durationSec Int       @default(0)
  status      String    @default("ACTIVE")
  /// Seconds spent paused so far, not counting a pause still running.
  pausedSec   Int       @default(0)
  /// Set while paused.
  pausedAt    DateTime?
  /// Holds userId while ACTIVE and null after, so the unique index allows one ACTIVE session per user.
  activeKey   String?   @unique

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post?

  @@index([userId, startedAt])
  @@index([userId, status])
  @@index([status, lastBeatAt])
}

/// Focused seconds per user per calendar day in that user's zone. Updated when a session ends.
model DailyStat {
  userId  String
  /// "YYYY-MM-DD"
  day     String
  seconds Int    @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, day])
  @@index([day, seconds])
}

/// type: LIKE | COMMENT | FOLLOW | SESSION_START | NUDGE | BUDDY_REQUEST | BUDDY_ACCEPT
model Notification {
  id        String    @id @default(cuid())
  userId    String
  actorId   String
  type      String
  postId    String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user  User @relation("recipient", fields: [userId], references: [id], onDelete: Cascade)
  actor User @relation("actor", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

/// A pairing of two users. status: PENDING | ACCEPTED
model Buddy {
  id          String   @id @default(cuid())
  requesterId String
  addresseeId String
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())

  requester User @relation("requester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("addressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
}

model Room {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  ownerId   String
  createdAt DateTime @default(now())

  owner   User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  members RoomMember[]
}

model RoomMember {
  roomId   String
  userId   String
  joinedAt DateTime @default(now())

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([roomId, userId])
  @@index([userId])
}

/// One-time password reset links. Only a hash of the token is kept.
model PasswordReset {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// A Google or GitHub login connected to an account. provider: "google" | "github"
model OAuthAccount {
  id             String   @id @default(cuid())
  userId         String
  provider       String
  /// The provider's own id for the person (Google "sub", GitHub user id). Emails can change; this can't.
  providerUserId String
  /// The verified email the provider gave when it was connected, shown in settings.
  email          String?
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  /// one Google and one GitHub per account
  @@unique([userId, provider])
}

/// One-time email verification links. Only a hash of the token is kept.
model EmailVerification {
  id        String   @id @default(cuid())
  userId    String
  /// The address the link was sent to. Verifying only counts while it's still the account's address.
  email     String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Fixed-window counters. In the database so limits hold across serverless instances.
model RateLimit {
  key     String   @id
  count   Int      @default(0)
  resetAt DateTime

  @@index([resetAt])
}

model Post {
  id        String   @id @default(cuid())
  userId    String
  sessionId String?  @unique
  mediaUrl  String?
  /// "image" | "timelapse"
  mediaType String?
  views     Int      @default(0)
  body      String
  /// Set when enough people report it.
  hidden    Boolean  @default(false)
  createdAt DateTime @default(now())

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  session  FocusSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  likes    Like[]
  comments Comment[]
  viewers  PostView[]

  @@index([createdAt, id])
  @@index([userId, createdAt, id])
}

/// One row per viewer per post per day, so a view only counts once a day. Old days are cleared out.
model PostView {
  postId String
  userId String
  /// "YYYY-MM-DD" in the viewer's zone
  day    String

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId, day])
  @@index([day])
}

model Like {
  userId    String
  postId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
  @@index([postId])
}

model Comment {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  body      String
  /// Set when enough people report it.
  hidden    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
}

model Follow {
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("following", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followingId])
}

/// A focus challenge on the Home quest board.
model Quest {
  id             String    @id @default(cuid())
  creatorId      String
  title          String
  description    String?
  /// "solo": everyone races their own target. "group": everyone's time adds up to one target.
  type           String
  /// At least one of these two is set.
  targetMinutes  Int?
  targetSessions Int?
  /// Only sessions at least this long count.
  minSessionMin  Int?
  /// Only sessions with this label count, matched without case.
  tag            String?
  /// One of the fixed pastels in src/lib/quests.ts.
  color          String
  startsAt       DateTime  @default(now())
  endsAt         DateTime
  /// Set when a group quest reaches its target.
  completedAt    DateTime?
  hidden         Boolean   @default(false)
  createdAt      DateTime  @default(now())

  creator      User               @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  participants QuestParticipant[]

  @@index([hidden, endsAt])
  @@index([creatorId, createdAt])
}

model QuestParticipant {
  questId          String
  userId           String
  joinedAt         DateTime  @default(now())
  progressSec      Int       @default(0)
  progressSessions Int       @default(0)
  /// Set when this person meets a solo quest's target, or when their group quest is done.
  completedAt      DateTime?

  quest Quest @relation(fields: [questId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([questId, userId])
  @@index([userId, completedAt])
  @@index([questId, joinedAt])
}

/// The wall's question of the day. Days without one use the built-in bank in src/lib/wall.ts.
model DailyQuestion {
  id          String   @id @default(cuid())
  /// "YYYY-MM-DD", in the app's time zone
  day         String   @unique
  question    String
  options     String[]
  createdById String?
  createdAt   DateTime @default(now())

  createdBy User?          @relation(fields: [createdById], references: [id], onDelete: SetNull)
  votes     QuestionVote[]
}

model QuestionVote {
  questionId String
  userId     String
  option     Int
  createdAt  DateTime @default(now())

  question DailyQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([questionId, userId])
}

/// A short opinion on the wall.
model Take {
  id        String   @id @default(cuid())
  authorId  String
  body      String
  hidden    Boolean  @default(false)
  createdAt DateTime @default(now())

  author    User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  reactions TakeReaction[]

  @@index([hidden, createdAt])
  @@index([authorId, createdAt])
}

model TakeReaction {
  takeId    String
  userId    String
  /// "agree" | "disagree"
  value     String
  createdAt DateTime @default(now())

  take Take @relation(fields: [takeId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([takeId, userId])
  @@index([takeId, value])
}

/// Someone flagging content or a person. Enough reports hide content (people are left to admins).
model Report {
  id         String    @id @default(cuid())
  reporterId String
  /// "post" | "comment" | "quest" | "take" | "user"
  targetType String
  targetId   String
  /// "spam" | "harassment" | "inappropriate" | "other". Null on reports made before reasons existed.
  reason     String?
  /// Set when an admin deals with it. Only open reports count towards hiding something.
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())

  reporter User @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@unique([reporterId, targetType, targetId])
  @@index([targetType, targetId])
}
